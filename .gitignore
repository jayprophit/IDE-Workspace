# Dependencies
node_modules/
**/node_modules/
workspace/app/node_modules/

# Build outputs
dist/
build/
workspace/app/dist/
workspace/app/package-lock.json

# Logs
*.log
*.log.err
workspace/app/*.log
workspace/app/*.log.err
workspace/app/dev-server*.log
workspace/app/dev-server*.log.err

# Checkpoints and sessions
workspace/.bridge/**

# Cache
__pycache__/
workspace/integration/__pycache__/
*.pyc

# IDE/Editor
.venv/
venv/
*.swp
*.swo

# Archives
references/vibe-prototype/aetherius-ide.zip

# Environment
.env
.env.local
.env.*.local
workspace/integration/.env.local.example

# Agent Bridge runtime state.
# The IDE hosts a real Bridge runtime (workspace/.bridge), which writes sessions,
# approvals, completed_actions, history and checkpoints. Agent Bridge ignores its
# own .bridge/ for the same reason; without this rule here, a 'git add -A'
# would commit 66 runtime-state files into the IDE repository. Runtime state
# is local by definition and is never a source artifact.
.bridge/
workspace/.bridge/

# IDE-side Agent Bridge worker state (default IDE_WORKER_DIR). The integration
# launcher written by BridgeService.start_injected() lands here, and a hosted
# runtime writes its own worker artifacts beside it. Runtime/generated state is
# local by definition and is never a source artifact - same rule as .bridge/.
workspace/.agent-worker-test/
.agent-worker-test/
**/.pytest_cache/
